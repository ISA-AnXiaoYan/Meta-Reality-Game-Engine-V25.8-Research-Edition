{
  "schema_version": "2",
  "repository": "Meta-Reality-Game-Engine-Research-Edition",
  "public_policy": "supported clean-room research package plus frozen authorized historical archive",
  "active_research_package": {
    "paths": ["src/mrge", "contracts", "replay", "examples", "research"],
    "origin": "public research implementation and contracts",
    "license_boundary": "See LICENSES/LICENSE-MAP.md"
  },
  "historical_archive": {
    "paths": ["historical/v25.8", "historical/v26", "historical/knowledge-graph"],
    "origin": "maintainer-declared authorized V25.8–V26 source, records, configuration and deployment history",
    "integrity_record": "historical/RELEASE_MANIFEST.json",
    "exclusions": "historical/EXCLUSIONS.md",
    "license_audit": "historical/LICENSE_AUDIT.json",
    "support_status": "historical/SUPPORT_STATUS.md"
  },
  "excluded": [
    "supplier SDKs and binaries",
    "model weights",
    "credentials, certificates and tokens",
    "unauthorized personal material",
    "unlicensed or unclear-provenance material",
    "explicitly proprietary source trees"
  ],
  "authority_boundary": {
    "qualification_claimed": false,
    "field_effectiveness_validated": false,
    "production_cutover": false,
    "authority": "research-only"
  }
}
